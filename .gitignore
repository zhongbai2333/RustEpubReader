# Generated by Cargo
# will have compiled files and executables
debug/
!android/app/src/debug/
!android/app/src/debug/**
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover / IntelliJ / Android Studio
.idea/

# Added by cargo
/target

# Android build outputs
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/app/bin/
android/pagecurl/build/

# Android local configuration (contains machine-specific SDK path)
android/local.properties

# Android signing keystore (NEVER commit)
*.keystore
*.jks

# VS Code
.vscode/

library.json
peers.json
settings.json
books/
.cache/shelf-covers-v1/
.cache/chapter-index/
.epub-import-*.tmp
models/
android/app/src/main/jniLibs/
# Device-local sync journal (no credentials)
github-sync-local.json
github-sync-local.json.tmp
github-sync-staging/

# Device-local reading history and temporary encrypted book shares
reading-activity.json
reading-activity.json.tmp
book-share-history.json
.book-share-history-*.tmp
.book-share-tmp/

# Device-local failed-transfer queue
github-sync-transfers/
github-sync-chunks/

# Xcode user state and local build products (keep shared scheme / Package.resolved)
**/xcuserdata/
**/*.xcuserstate
ios/DerivedData/
ios/build/
*.mobileprovision
*.p12

# Python development-script cache
**/__pycache__/
