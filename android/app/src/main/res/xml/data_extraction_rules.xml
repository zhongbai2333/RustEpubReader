<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="github_credentials.xml" />
        <exclude domain="sharedpref" path="reader_settings.xml" />
        <exclude domain="file" path="github-sync-local.json" />
        <exclude domain="file" path="github-sync-staging/" />
        <exclude domain="file" path="peers.json" />
        <exclude domain="file" path=".book-share-tmp/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="github_credentials.xml" />
        <exclude domain="sharedpref" path="reader_settings.xml" />
        <exclude domain="file" path="github-sync-local.json" />
        <exclude domain="file" path="github-sync-staging/" />
        <exclude domain="file" path="peers.json" />
        <exclude domain="file" path=".book-share-tmp/" />
    </device-transfer>
</data-extraction-rules>
