[
  {
    "name": "system wins initial conflict",
    "initial": {
      "version": 1,
      "source": "system",
      "appLinked": true,
      "readingLinked": true,
      "appManual": false,
      "readingMode": "automatic",
      "readingSource": "system"
    },
    "system": true,
    "ambient": false,
    "actions": [],
    "expected": {
      "app": true,
      "reading": true,
      "appLinked": true,
      "readingLinked": true
    }
  },
  {
    "name": "ambient wins conflict",
    "initial": {
      "version": 1,
      "source": "system",
      "appLinked": true,
      "readingLinked": true,
      "appManual": false,
      "readingMode": "automatic",
      "readingSource": "system"
    },
    "system": true,
    "ambient": false,
    "actions": [
      "source:ambient"
    ],
    "expected": {
      "app": false,
      "reading": false,
      "appLinked": true,
      "readingLinked": true
    }
  },
  {
    "name": "missing ambient falls back to system",
